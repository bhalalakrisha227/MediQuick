# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is git-ignored. NEVER put real secrets in this example file.

# --- Django ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Auth (Phase 1) ---
# Separate signing key for JWTs (generate like DJANGO_SECRET_KEY). Falls back to DJANGO_SECRET_KEY if blank.
JWT_SECRET_KEY=
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=14
MAX_FAILED_LOGINS=5
LOGIN_LOCK_MINUTES=15

# --- Payments (Phase 4) ---
# Only "mock" exists: no real money is charged, and it only runs when DJANGO_DEBUG=True.
# Notifications: EMAIL_PROVIDER = none | console (DEBUG only) | smtp. Use a TEST inbox (e.g. Mailtrap) first. No SMS provider exists.
EMAIL_PROVIDER=none
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=True
FRONTEND_URL=http://localhost:5173
# Hosting behind a proxy / load balancer that ends HTTPS: set both (THROTTLE_NUM_PROXIES = how many proxies are in front).
BEHIND_TLS_PROXY=False
THROTTLE_NUM_PROXIES=0
# Delivery: comma-separated PIN code prefixes we deliver to. Empty = no restriction (demo).
DELIVERY_PINCODE_PREFIXES=
PAYMENT_PROVIDER=mock
# To try Razorpay TEST mode set PAYMENT_PROVIDER=razorpay and fill these (from the Razorpay dashboard, Test mode).
# NEVER commit real values. Live keys (rzp_live_...) are refused by the app.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_ALLOW_LIVE=False

# --- CORS: origins of the React dev server ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- MongoDB Atlas ---
# Paste the connection string from Atlas (Connect > Drivers) with your
# database user's password filled in. URL-encode special characters in the password.
MONGODB_URI=
MONGODB_DB_NAME=mediquick
MONGODB_TIMEOUT_MS=5000

# --- Uploads (used from Phase 5) ---
MAX_UPLOAD_SIZE_MB=5
# Leave blank to use backend/private_storage (outside any public/static path)
PRIVATE_STORAGE_DIR=

# --- Background task runner ---
# "thread" = in-process thread pool (Windows-friendly, no Redis/Docker)
TASK_RUNNER=thread
TASK_MAX_WORKERS=2

# --- Prescription OCR (Phase 5) ---
OCR_ENGINE=tesseract
OCR_LANG=eng
OCR_TIMEOUT_SECONDS=60
# Full path to tesseract.exe if "tesseract --version" does not work in a new terminal, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
MAX_PDF_PAGES=3
MAX_IMAGE_MEGAPIXELS=25
# Maximum days an approved prescription stays valid (placeholder rule, needs professional review)
PRESCRIPTION_VALIDITY_DAYS=30
